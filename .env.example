# Environment
ENVIRONMENT=development

# API
API_HOST=127.0.0.1
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/app.db

# Storage
STORAGE_DIR=./data/projects
TEMP_DIR=./data/temp

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log

# LLM Provider (mock, gemini, ollama)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_RETRY_COUNT=3

# TTS Provider (mock, google, elevenlabs)
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_BASE_URL=

# Video Provider (mock, runwayml, other)
VIDEO_PROVIDER=mock
VIDEO_API_KEY=
VIDEO_BASE_URL=

# Research Provider (mock, serper, other)
RESEARCH_PROVIDER=mock
RESEARCH_API_KEY=

# FFmpeg
FFMPEG_PATH=ffmpeg

# Content defaults
DEFAULT_LANGUAGE=en
DEFAULT_DURATION_SECONDS=45
DEFAULT_RESOLUTION=1080x1920
DEFAULT_FPS=30
DEFAULT_ASPECT_RATIO=9:16

# Job system
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=3600
JOB_RETRY_MAX_ATTEMPTS=3

# Offline mode (set to true for development without external providers)
OFFLINE_MODE=false
